# Copy this file to .env.local and use keys from Stripe's test-mode dashboard.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_PUBLISHABLE_KEY
EXPO_PUBLIC_STRIPE_PAYMENT_INTENT_URL=https://your-api.example.com/api/stripe/payment-intent

# Enable Places API (New) in Google Cloud, then restrict the key to this Android/iOS app.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIza_REPLACE_WITH_YOUR_RESTRICTED_KEY

# Native response: { "clientSecret": "pi_..._secret_..." }
# Web response:    { "checkoutUrl": "https://checkout.stripe.com/c/pay/..." }
# Configure the Checkout Session success_url as:
# https://your-app.example.com/cart?payment=success&session_id={CHECKOUT_SESSION_ID}
